{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Xournal++",
  "description": "Take handwritten notes and annotate PDF documents.",
  "version": "1.3.3",
  "image": "ghcr.io/containerpak/xournalpp@sha256:3107191b87acc0fceb56902a453e77158fb088e0d597a2808c2c3f5589e430a8",
  "binaries": [
    "/usr/bin/xournalpp"
  ],
  "desktop_entries": [
    "/usr/share/applications/com.github.xournalpp.xournalpp.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": true,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": true,
    "hostApplications": false,
    "hostActions": [],
    "filesystem": [
      {
        "path": "xdg-documents",
        "access": "read-write"
      },
      {
        "path": "xdg-download",
        "access": "read-write"
      },
      {
        "path": "xdg-pictures",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
